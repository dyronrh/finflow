# Copy to .env for local development. Never commit real credentials.
# Trading controls (README §15.3). Execution needs GLOBAL_TRADING_ENABLED=true.
# Live trading is not implemented: LIVE_TRADING_ENABLED=true is refused.
# Emergency stop: `python pipelines/paper_trade.py kill --reason "..."`.
GLOBAL_TRADING_ENABLED=false
PAPER_TRADING_ENABLED=true
LIVE_TRADING_ENABLED=false

# Alpaca *paper* account (https://alpaca.markets, free sandbox) for --broker alpaca
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# Required by SEC EDGAR (fair-access policy): a contact e-mail.
SEC_USER_AGENT='finflow research you@example.com'

# Paid data vendors (not wired yet)
MARKET_DATA_API_KEY=
FUNDAMENTALS_API_KEY=
ESTIMATES_API_KEY=

DATABASE_URL=postgresql://quant:quant@localhost:5432/quant
REDIS_URL=redis://localhost:6379/0
